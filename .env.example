# Safety first: inspect logs before changing this to false.
DRY_RUN=true
WORKERS=2
SCAN_INTERVAL_MINUTES=60
MIN_SAVINGS_PERCENT=15

# Pin a version such as 1.0.0 for reproducible deployments.
ARRSE_IMAGE=ghcr.io/sampotts/arrse:latest

# Required library path on the Docker host. Arrse scans it recursively and
# replaces successful outputs in place; there is no separate output path.
INPUT_PATH=/path/to/library

# Optional storage paths used by docker-compose.yml
# CONFIG_PATH=/path/to/arrse/config
# CACHE_PATH=/path/to/arrse/cache

# Intel Quick Sync settings
QSV_DEVICE=/dev/dri/renderD128
QSV_QUALITY=23
QSV_PRESET=medium

# Optional. Set both values for each application you use.
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=replace-me
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=replace-me
